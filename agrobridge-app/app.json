{
  "expo": {
    "name": "AgroBridge",
    "slug": "agrobridge-app",
    "scheme": "agrobridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agrobridge.app"
    },
    "android": {
      "package": "Agro.bridge",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2962ff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "@react-native-google-signin/google-signin",
      "expo-font",
      "expo-splash-screen"
    ]
  }
}
